!terraform.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Sensitive/local files
.env
.env.*

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db